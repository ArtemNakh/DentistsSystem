# середовище
ENVIRONMENT=dev
APPLICATION_PORT=4000
APPLICATION_URL="http://localhost:${APPLICATION_PORT}"
APPLICATION_ORIGIN='http://localhost:3000'

 #налаштування сесії та кукі
COOKIES_SECRET='secret'
SESSION_SECRET='secret'
SESSION_NAME='session'
SESSION_DOMAIN='localhost'
SESSION_MAX_AGE='30d'
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
# SESSION_FOLDER='sessions:'
SESSION_FOLDER=sessions






# база даних
MYSQL_HOST=localhost       # локальний доступ до контейнера
MYSQL_PORT=3306            # порт, який проброшений у docker-compose.yml
MYSQL_ROOT_PASSWORD=secret123
MYSQL_USER=appuser         # користувач, створений у docker-compose.yml
MYSQL_PASSWORD=appuser123
MYSQL_DB=dental_clinic

 
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_DB=dental_clinic
# MYSQL_PASSWORD=secret123
# MYSQL_PORT=3306
